<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  NOT sandboxed. CGEvent taps (global hotkey) and AXUIElement calls
	  (reading/writing text in other apps) are blocked by App Sandbox.
	  Every real macOS productivity tool that does system-wide input
	  (Alfred, Keyboard Maestro, Raycast, Bartender) ships non-sandboxed.
	  Distribute via Developer ID / notarization, not the Mac App Store.
	-->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
