# Fastfile — VoiceFlow TestFlight publishing.
#
# Usage (from the ios/ directory):
#
#   bundle exec fastlane beta
#
# What the `beta` lane does:
#   1. Loads credentials from ~/.voiceflow.env
#   2. Writes Secrets.swift from $ANTHROPIC_API_KEY
#   3. Bumps CFBundleVersion in Info.plist to (latest TestFlight + 1)
#   4. Archives in Release config with automatic signing
#   5. Uploads to TestFlight via the App Store Connect API
#
# Required env vars in ~/.voiceflow.env:
#
#   ANTHROPIC_API_KEY                       sk-ant-...
#   VOICEFLOW_TEAM_ID                       10-char Team ID
#   VOICEFLOW_APP_STORE_CONNECT_KEY_ID      10-char Key ID
#   VOICEFLOW_APP_STORE_CONNECT_ISSUER_ID   UUID issuer ID
#   VOICEFLOW_APP_STORE_CONNECT_KEY_PATH    absolute path to .p8
#
# Optional:
#   VOICEFLOW_APP_ID       defaults to com.hak-tx.voiceflow
#   VOICEFLOW_CHANGELOG    TestFlight changelog, defaults to git SHA

default_platform(:ios)

PROJECT      = "VoiceFlow.xcodeproj"
SCHEME       = "VoiceFlow"
INFO_PLIST   = "VoiceFlow/Info.plist"

platform :ios do

  before_all do
    env_file = File.expand_path("~/.voiceflow.env")
    if File.exist?(env_file)
      File.foreach(env_file) do |line|
        next if line =~ /^\s*#/
        if (m = line.strip.match(/\A([A-Z0-9_]+)=(.*)\z/))
          # Use = (not ||=) so the file is the source of truth and
          # overrides any stale shell env from prior runs.
          ENV[m[1]] = m[2]
        end
      end
    end
  end

  desc "Write Secrets.swift from $ANTHROPIC_API_KEY"
  lane :secrets do
    Dir.chdir("../..") do
      sh("./Scripts/generate-secrets.sh")
    end
  end

  desc "Build and upload a new TestFlight build"
  lane :beta do
    secrets

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("VOICEFLOW_APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("VOICEFLOW_APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("VOICEFLOW_APP_STORE_CONNECT_KEY_PATH"),
      in_house: false
    )

    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: ENV.fetch("VOICEFLOW_APP_ID", "com.hak-tx.voiceflow"),
      initial_build_number: 0
    )
    next_build = latest.to_i + 1
    UI.message("Bumping build number to #{next_build}")

    # Our project uses GENERATE_INFOPLIST_FILE=NO with an explicit
    # Info.plist, so we edit CFBundleVersion directly via plutil
    # instead of using fastlane's agvtool-based build-number action.
    sh("plutil -replace CFBundleVersion -string '#{next_build}' ../#{INFO_PLIST}")

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: "build",
      output_name: "VoiceFlow.ipa",
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{ENV.fetch('VOICEFLOW_TEAM_ID')}"
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: ENV.fetch("VOICEFLOW_APP_ID", "com.hak-tx.voiceflow"),
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      changelog: ENV["VOICEFLOW_CHANGELOG"] || "Build from #{`git rev-parse --short HEAD`.strip}."
    )

    UI.success("Uploaded build #{next_build} to TestFlight. Wait 5-15 min for Apple processing.")
  end

  desc "Build-only sanity check (no upload)"
  lane :build_only do
    secrets
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: "build",
      output_name: "VoiceFlow.ipa",
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{ENV.fetch('VOICEFLOW_TEAM_ID')}"
    )
  end
end
