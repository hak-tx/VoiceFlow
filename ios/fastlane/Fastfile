# Fastfile — VoiceFlow TestFlight publishing.
#
# Usage (from the ios/ directory):
#
#   bundle exec fastlane beta
#
# Required environment variables (set in ~/.voiceflow.env or your
# shell profile; do NOT commit them):
#
#   ANTHROPIC_API_KEY              sk-ant-...
#   VOICEFLOW_APPLE_ID             you@example.com
#   VOICEFLOW_TEAM_ID              ABCD123XYZ
#   VOICEFLOW_APP_STORE_CONNECT_KEY_ID
#   VOICEFLOW_APP_STORE_CONNECT_ISSUER_ID
#   VOICEFLOW_APP_STORE_CONNECT_KEY_PATH   absolute path to the .p8
#
# The `beta` lane:
#   1. Regenerates the Xcode project from project.yml via xcodegen
#   2. Writes Secrets.swift from $ANTHROPIC_API_KEY
#   3. Bumps the build number (uses the App Store Connect latest + 1)
#   4. Builds and signs a release archive (gym)
#   5. Uploads to TestFlight via the App Store Connect API (pilot)

default_platform(:ios)

WORKSPACE = nil
PROJECT   = "VoiceFlow.xcodeproj"
SCHEME    = "VoiceFlow"

platform :ios do

  before_all do
    # Pull in ~/.voiceflow.env if present so the fastlane run picks up
    # API keys without you having to export them every terminal.
    env_file = File.expand_path("~/.voiceflow.env")
    if File.exist?(env_file)
      File.foreach(env_file) do |line|
        next if line =~ /^\s*#/
        if (m = line.strip.match(/\A([A-Z0-9_]+)=(.*)\z/))
          ENV[m[1]] ||= m[2]
        end
      end
    end
  end

  desc "Regenerate Xcode project from project.yml"
  lane :regen do
    sh("which xcodegen > /dev/null || brew install xcodegen")
    Dir.chdir("..") do
      sh("xcodegen generate")
    end
  end

  desc "Write Secrets.swift from $ANTHROPIC_API_KEY"
  lane :secrets do
    Dir.chdir("../..") do
      sh("./Scripts/generate-secrets.sh")
    end
  end

  desc "Build and upload a new TestFlight build"
  lane :beta do
    regen
    secrets

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("VOICEFLOW_APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("VOICEFLOW_APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("VOICEFLOW_APP_STORE_CONNECT_KEY_PATH"),
      in_house: false
    )

    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: ENV.fetch("VOICEFLOW_APP_ID", "com.hak-tx.voiceflow"),
      initial_build_number: 0
    )
    next_build = latest.to_i + 1

    increment_build_number(
      xcodeproj: PROJECT,
      build_number: next_build.to_s
    )

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: "build",
      output_name: "VoiceFlow.ipa",
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{ENV.fetch('VOICEFLOW_TEAM_ID')}"
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: ENV.fetch("VOICEFLOW_APP_ID", "com.hak-tx.voiceflow"),
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      changelog: ENV["VOICEFLOW_CHANGELOG"] || "New internal build from #{`git rev-parse --short HEAD`.strip}."
    )
  end

  desc "Build without uploading (sanity check that everything compiles and signs)"
  lane :build_only do
    regen
    secrets
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      skip_archive: false,
      skip_codesigning: false,
      export_method: "app-store",
      output_directory: "build",
      output_name: "VoiceFlow.ipa",
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{ENV.fetch('VOICEFLOW_TEAM_ID')}"
    )
  end
end
